# Copier vers python/deploy/.env sur le VPS (fichier non versionné).
WEBALL_DATABASE_URL=postgresql+psycopg://weball:CHANGER_MOI@ines-postgres:5432/weball
WEBALL_SITE_URL=https://weball.weballone.com
# Arborescence INES : noms et descriptions des 5 groupes et 25 types (nœuds weball-*).
# Sans valeur ou si INES ne répond pas, Weball garde son catalogue local.
WEBALL_INES_API_URL=http://ines-backend:8000
INES_NETWORK=ines_ines-network
