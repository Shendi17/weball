# .htaccess simplifié pour WebAll
RewriteEngine On
RewriteBase /

# 1. Autoriser TOUS les fichiers PHP à la racine (pour test)
RewriteCond %{REQUEST_FILENAME} -f
RewriteCond %{REQUEST_FILENAME} \.php$
RewriteRule ^ - [L]

# 2. Autoriser tous les fichiers statiques existants
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# 3. Rediriger tout le reste vers index.php
RewriteRule ^annuaire\.php$ pages/annuaire.php [L]
RewriteRule ^personnalite\.php$ pages/personnalite.php [L]
RewriteRule ^autorite\.php$ pages/autorite.php [L]
RewriteRule ^entite\.php$ pages/entite.php [L]
RewriteRule ^localite\.php$ pages/localite.php [L]
RewriteRule ^banque\.php$ pages/banque.php [L]
RewriteRule ^cadran\.php$ pages/cadran.php [L]
RewriteRule ^ecran\.php$ pages/ecran.php [L]
RewriteRule ^instrument\.php$ pages/instrument.php [L]
RewriteRule ^office\.php$ pages/office.php [L]
RewriteRule ^reseau\.php$ pages/reseau.php [L]
RewriteRule ^journal\.php$ pages/journal.php [L]
RewriteRule ^publication\.php$ pages/publication.php [L]
RewriteRule ^archive\.php$ pages/archive.php [L]
RewriteRule ^media\.php$ pages/media.php [L]
RewriteRule ^formation\.php$ pages/formation.php [L]
RewriteRule ^annonce\.php$ pages/annonce.php [L]
RewriteRule ^catalogue\.php$ pages/catalogue.php [L]
RewriteRule ^boutique\.php$ pages/boutique.php [L]
RewriteRule ^adhesion\.php$ pages/adhesion.php [L]
RewriteRule ^projet\.php$ pages/projet.php [L]
RewriteRule ^carriere\.php$ pages/carriere.php [L]
RewriteRule ^discipline\.php$ pages/discipline.php [L]
RewriteRule ^concours\.php$ pages/concours.php [L]
RewriteRule ^campagne\.php$ pages/campagne.php [L]
# Redirection de /login vers /login.php
RewriteRule ^login$ login.php [L]

# Interdire l'accès direct aux fichiers PHP dans /templates
RewriteRule ^templates/.*\.php$ - [F,L]

# Autoriser l'accès direct aux fichiers existants (fichiers statiques)
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# Autoriser l'accès direct aux répertoires existants
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Rediriger toutes les autres requêtes vers index.php
RewriteRule ^(.*)$ index.php [QSA,L]

# Redirection des erreurs vers des pages personnalisées
ErrorDocument 404 /404.php
ErrorDocument 500 /500.php

# Protection du fichier .htaccess
<Files .htaccess>
    Order allow,deny
    Deny from all
</Files>

# Compression GZIP
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
</IfModule>

# Cache Control
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType application/pdf "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 week"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType text/html "access plus 1 minute"
</IfModule>

# Sécurité
ServerSignature Off

# Headers CORS
<IfModule mod_headers.c>
    Header set Access-Control-Allow-Origin "*"
    Header set Access-Control-Allow-Methods "GET, POST, OPTIONS"
    Header set Access-Control-Allow-Headers "*"
</IfModule>